# Copy to .streamlit/secrets.toml (or paste into your host's "Secrets" box). Never share it.

# ---- Admin login (REQUIRED, otherwise the admin area stays disabled) ----
ADMIN_PASSWORD = "choose-a-long-password"

# ---- Where data is stored ----
# "sheets" = Google Sheets (use this when deployed)   |   "excel" = local payments.xlsx
STORAGE_BACKEND = "sheets"
# Optional: ID of an existing Google Sheet (the long part of its URL). If empty, the app
# finds/creates a sheet called SHEETS_NAME in your Drive.
SHEETS_SPREADSHEET_ID = ""
SHEETS_NAME = "Gayatri Nagar Payments"

# ---- Google login for a deployed app (no browser on a server) ----
# Run  python authorize_google.py  on your PC and paste the line it prints here:
# GOOGLE_TOKEN_JSON = '''{"token": "...", "refresh_token": "...", ...}'''

# ---- Google Drive ----
DRIVE_FOLDER_NAME = "Payment Receipts"            # PDF receipts (anyone with link can view)
DRIVE_SCREENSHOT_FOLDER = "Payment Screenshots"   # payers' screenshots
SCREENSHOT_LINK_PUBLIC = false                    # false = only you can open them (recommended)
ENABLE_DRIVE_UPLOAD = true                        # false = don't store screenshots/PDFs in Drive

# ---- Public form (optional) ----
# Text that must appear on the screenshot to prove the payment went to YOU
# (your UPI ID and/or name as shown in payer apps). Comma-separated. Leave "" to skip.
RECEIVER_HINTS = "yourupi@okbank,Your Name"

# ---- Receipts ----
ORG_NAME = "Your Organisation Name"
ORG_ADDRESS = "Your address, City, State - PIN"
ORG_PHONE = "98xxxxxxxx"
RECEIPT_PREFIX = "RCP"

# Email (Gmail): enable 2-step verification, then create an App Password
SMTP_USER = "yourname@gmail.com"
SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"
DEFAULT_COUNTRY_CODE = "91"
